{
  "name": "flipkart-playwright-qa-framework",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags '@smoke'",
    "test:search": "cucumber-js --tags '@search'",
    "test:product": "cucumber-js --tags '@product'",
    "test:network": "cucumber-js --tags '@network'",
    "test:api": "cucumber-js --tags '@api'",
    "test:db": "cucumber-js --tags '@db'",
    "test:regression": "cucumber-js --tags '@regression and not @manual'",
    "test:parallel": "cucumber-js --parallel 3 --tags '@regression and not @manual'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:up": "docker compose up -d mysql",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:report": "tsx scripts/report-summary.ts",
    "manual:login": "tsx scripts/save-manual-session.ts",
    "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "db:wait": "tsx scripts/wait-for-mysql.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mysql2": "^3.14.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.2.1",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
